<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- VIEWPAGER SLIDE ẢNH FULL MÀN -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- DOT INDICATOR -->
    <LinearLayout
        android:id="@+id/layoutDots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="140dp" />

    <!-- SEGMENTED LOGIN / GUEST -->
    <!-- SEGMENTED LOGIN / GUEST (EVO-STYLE) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/segmentedContainer"
        android:layout_width="300dp"
        android:layout_height="40dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="28dp"
        app:cardCornerRadius="20dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/segment_outline"
        app:cardBackgroundColor="@android:color/white">

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleAuth"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:padding="2dp"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogin"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/login"
                android:textAllCaps="false"
                android:checkable="true"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="40dp"
                android:textSize="14sp"
                app:icon="@drawable/ic_check_24"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:iconTint="@color/segment_icon"
                android:textColor="@color/segment_text"
                app:backgroundTint="@color/segment_bg"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.IntroPill" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGuest"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/guest"
                android:textAllCaps="false"
                android:checkable="true"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="40dp"
                android:textSize="14sp"
                app:icon="@drawable/ic_person_24"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:iconTint="@color/segment_icon"
                android:textColor="@color/segment_text"
                app:backgroundTint="@color/segment_bg"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.IntroPill" />

        </com.google.android.material.button.MaterialButtonToggleGroup>

    </com.google.android.material.card.MaterialCardView>

</FrameLayout>

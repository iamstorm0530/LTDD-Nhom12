<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F2F2F7">

    <!-- ================= HEADER ================= -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingHorizontal="20dp"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_back"
            app:tint="#1C1C1E" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_centerInParent="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Products"
            android:textSize="17sp"
            android:textColor="#1C1C1E"
            android:fontFamily="sans-serif-medium"/>
    </RelativeLayout>

    <!-- ================= SEARCH ================= -->
    <EditText
        android:id="@+id/edtSearch"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_search"
        android:hint="Search product..."
        android:paddingHorizontal="16dp"
        android:inputType="text"
        android:textSize="14sp"/>

    <!-- ================= TAG FILTER ================= -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/layoutTags"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="ALL"
                android:layout_marginEnd="10dp"
                style="@style/TagItem"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="MALE"
                android:layout_marginEnd="10dp"
                style="@style/TagItem"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="FEMALE"
                android:layout_marginEnd="10dp"
                style="@style/TagItem"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="KIDS"
                android:layout_marginEnd="10dp"
                style="@style/TagItem"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="UNISEX"
                style="@style/TagItem"/>

            <ImageView
                android:id="@+id/btnSort"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_filter"
                android:padding="6dp"
                android:contentDescription="Sort"
                android:layout_marginEnd="12dp"/>


        </LinearLayout>
    </HorizontalScrollView>

    <!-- ================= STATUS FILTER (HORIZONTAL SCROLL) ================= -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:overScrollMode="never"
        android:fillViewport="false">

        <LinearLayout
            android:id="@+id/layoutStatusFilter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="6dp"
            android:paddingBottom="4dp">

            <TextView
                android:text="ACTIVE"
                android:layout_height="32dp"
                android:layout_width="wrap_content"
                style="@style/TagItem"
                android:layout_marginEnd="10dp"/>

            <TextView
                android:text="HIDDEN"
                android:layout_height="32dp"
                android:layout_width="wrap_content"
                style="@style/TagItem"
                android:layout_marginEnd="10dp"/>

            <TextView
                android:text="OUT_OF_STOCK"
                android:layout_height="32dp"
                android:layout_width="wrap_content"
                style="@style/TagRedItem"
                android:layout_marginEnd="10dp"/>

            <TextView
                android:text="LOW_STOCK"
                android:layout_height="32dp"
                android:layout_width="wrap_content"
                style="@style/TagYellowItem"
                android:layout_marginEnd="10dp"/>

            <TextView
                android:text="IN_STOCK"
                android:layout_height="32dp"
                android:layout_width="wrap_content"
                style="@style/TagGreenItem"
                android:layout_marginEnd="10dp"/>

        </LinearLayout>
    </HorizontalScrollView>

    <!-- ================= LIST ================= -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvProducts"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp"
        android:clipToPadding="false"/>

    <!-- ================= BOTTOM NAV ================= -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_margin="16dp"
        app:cardCornerRadius="32dp"
        app:cardElevation="10dp"
        app:cardBackgroundColor="#2C2C2E">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center">

            <ImageView
                android:id="@+id/navDashboard"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:padding="12dp"
                android:clickable="true"
                android:focusable="true"
                android:src="@drawable/ic_dashboard"
                app:tint="#8E8E93" />

            <ImageView
                android:id="@+id/navProducts"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:padding="12dp"
                android:clickable="true"
                android:focusable="true"
                android:src="@drawable/ic_products"
                app:tint="#FFFFFF" />

            <ImageView
                android:id="@+id/navOrders"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:padding="12dp"
                android:clickable="true"
                android:focusable="true"
                android:src="@drawable/ic_orders"
                app:tint="#8E8E93" />

            <ImageView
                android:id="@+id/navUsers"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:padding="12dp"
                android:clickable="true"
                android:focusable="true"
                android:src="@drawable/ic_users"
                app:tint="#8E8E93" />

            <ImageView
                android:id="@+id/navSettings"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:padding="12dp"
                android:clickable="true"
                android:focusable="true"
                android:src="@drawable/ic_settings"
                app:tint="#8E8E93" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>

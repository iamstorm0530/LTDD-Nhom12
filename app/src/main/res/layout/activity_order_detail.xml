<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:padding="24dp">

    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_circle"
        android:src="@drawable/ic_back"
        android:scaleType="fitCenter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Track Order"
        android:textColor="#000000"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/btnBack"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnBack" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cvProduct"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#F9F9F9"
        app:layout_constraintTop_toBottomOf="@id/btnBack">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <ImageView
                android:id="@+id/imgProduct"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="#E0E0E0"
                android:scaleType="centerCrop"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <TextView
                android:id="@+id/tvProductName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Brown Suite"
                android:textStyle="bold"
                android:textColor="#000000"
                app:layout_constraintStart_toEndOf="@id/imgProduct"
                app:layout_constraintTop_toTopOf="@id/imgProduct"/>

            <TextView
                android:id="@+id/tvProductDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Size: XL | Qty: 1"
                android:textSize="12sp"
                app:layout_constraintStart_toStartOf="@id/tvProductName"
                app:layout_constraintTop_toBottomOf="@id/tvProductName"/>

            <TextView
                android:id="@+id/tvPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$120.00"
                android:textStyle="bold"
                android:textColor="#000000"
                android:layout_marginTop="4dp"
                app:layout_constraintStart_toStartOf="@id/tvProductName"
                app:layout_constraintTop_toBottomOf="@id/tvProductDetail"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/lblDetails"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Order Details"
        android:textStyle="bold"
        android:textColor="#000000"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cvProduct"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Expected Delivery Date"
        android:textColor="#888888"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/lblDetails"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="03 Sep 2026"
        android:textColor="#000000"
        android:textStyle="bold"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/lblDetails"/>

    <TextView
        android:id="@+id/lblTracking"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tracking ID"
        android:textColor="#888888"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/lblDetails"
        android:layout_marginTop="32dp"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TRK452126542"
        android:textColor="#000000"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/lblTracking"/>

    <TextView
        android:id="@+id/lblStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="Order Status"
        android:textStyle="bold"
        android:textColor="#000000"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/lblTracking"/>

    <ImageView
        android:id="@+id/step1_dot"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="16dp"
        android:src="@drawable/ic_check"
        app:tint="#000000"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/lblStatus"/>
    <TextView
        android:id="@+id/tvStep1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Order Placed"
        android:textStyle="bold"
        android:textColor="#000000"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toEndOf="@id/step1_dot"
        app:layout_constraintTop_toTopOf="@id/step1_dot"/>

    <View
        android:id="@+id/line1"
        android:layout_width="2dp"
        android:layout_height="40dp"
        android:background="#E0E0E0"
        app:layout_constraintStart_toStartOf="@id/step1_dot"
        app:layout_constraintEnd_toEndOf="@id/step1_dot"
        app:layout_constraintTop_toBottomOf="@id/step1_dot"/>

    <ImageView
        android:id="@+id/step2_dot"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_check"
        app:tint="#E0E0E0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/line1"/>

    <TextView
        android:id="@+id/tvStep2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="In Progress"
        android:textStyle="bold"
        android:textColor="#888888"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toEndOf="@id/step2_dot"
        app:layout_constraintTop_toTopOf="@id/step2_dot"/>

    <View
        android:id="@+id/line2"
        android:layout_width="2dp"
        android:layout_height="40dp"
        android:background="#E0E0E0"
        app:layout_constraintStart_toStartOf="@id/step2_dot"
        app:layout_constraintEnd_toEndOf="@id/step2_dot"
        app:layout_constraintTop_toBottomOf="@id/step2_dot"/>

    <ImageView
        android:id="@+id/step3_dot"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_check"
        app:tint="#E0E0E0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/line2"/>

    <TextView
        android:id="@+id/tvStep3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Shipped"
        android:textStyle="bold"
        android:textColor="#888888"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toEndOf="@id/step3_dot"
        app:layout_constraintTop_toTopOf="@id/step3_dot"/>

    <View
        android:id="@+id/line3"
        android:layout_width="2dp"
        android:layout_height="40dp"
        android:background="#E0E0E0"
        app:layout_constraintStart_toStartOf="@id/step3_dot"
        app:layout_constraintEnd_toEndOf="@id/step3_dot"
        app:layout_constraintTop_toBottomOf="@id/step3_dot"/>

    <ImageView
        android:id="@+id/step4_dot"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_check"
        app:tint="#E0E0E0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/line3"/>

    <TextView
        android:id="@+id/tvStep4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Delivered"
        android:textStyle="bold"
        android:textColor="#888888"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toEndOf="@id/step4_dot"
        app:layout_constraintTop_toTopOf="@id/step4_dot"/>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnConfirmReceived"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/bg_button_black"
        android:text="Confirm Received"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/step4_dot"
        app:layout_constraintVertical_bias="1.0"/>
</androidx.constraintlayout.widget.ConstraintLayout>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- NỀN -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/>
        </shape>
    </item>

    <!-- SÓNG TRÊN -->
    <item android:top="-40dp">
        <shape>
            <corners android:bottomLeftRadius="120dp"
                android:bottomRightRadius="120dp"/>
            <solid android:color="#FFFFFF"/>
            <size android:height="80dp"/>
        </shape>
    </item>

    <!-- SÓNG DƯỚI -->
    <item android:bottom="-40dp">
        <shape>
            <corners android:topLeftRadius="120dp"
                android:topRightRadius="120dp"/>
            <solid android:color="#FFFFFF"/>
            <size android:height="80dp"/>
        </shape>
    </item>

</layer-list>

<!-- bg_popup_sort.xml -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="#FFFFFF"/>

    <corners android:radius="12dp"/>

    <!-- viền nhẹ -->
    <stroke
        android:width="1dp"
        android:color="#E0E0E0"/>

    <!-- padding để không sát mép -->
    <padding
        android:left="4dp"
        android:top="4dp"
        android:right="4dp"
        android:bottom="4dp"/>
</shape>

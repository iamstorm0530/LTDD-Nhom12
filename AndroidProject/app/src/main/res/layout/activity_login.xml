<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Guideline chia màn hình -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideMiddle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.5"/>

    <!-- ================== ẢNH TRÊN ================== -->
    <ImageView
        android:id="@+id/imgTop"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/login1"
        android:scaleType="centerCrop"
        android:contentDescription="@string/login_header_image_desc"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/guideMiddle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- DARK OVERLAY TRÊN ẢNH TOP -->
    <View
        android:id="@+id/headerOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/gradient_dark_overlay"
        app:layout_constraintTop_toTopOf="@id/imgTop"
        app:layout_constraintBottom_toBottomOf="@id/imgTop"
        app:layout_constraintStart_toStartOf="@id/imgTop"
        app:layout_constraintEnd_toEndOf="@id/imgTop" />

    <!-- HEADER TEXT: nằm ngay phía trên hình wave -->
    <LinearLayout
        android:id="@+id/headerText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:elevation="30dp"
        android:translationZ="30dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@id/imgWave"
        android:layout_marginBottom="-108dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/login"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/welcome_back"
            android:textColor="#EDEDED"
            android:textSize="18sp" />
    </LinearLayout>


    <!-- ================== ẢNH DƯỚI ================== -->
    <ImageView
        android:id="@+id/imgBottom"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:src="@drawable/login2"
        android:translationY="240dp"
        app:layout_constraintTop_toBottomOf="@id/guideMiddle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.0" />

    <!-- ================== WAVE TRẮNG Ở GIỮA ================== -->
    <ImageView
        android:id="@+id/imgWave"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:src="@drawable/wave"
        android:scaleType="fitXY"
        android:scaleY="1.0"
        android:translationY="70dp"
        android:elevation="12dp"
        app:layout_constraintTop_toBottomOf="@id/imgTop"
        app:layout_constraintBottom_toTopOf="@id/imgBottom"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- ================== LOGIN FORM (đè lên wave) ================== -->
    <LinearLayout
        android:id="@+id/loginContent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp"
        android:layout_marginTop="120dp"
        android:layout_marginBottom="32dp"
        android:elevation="20dp"
        app:layout_constraintTop_toTopOf="@id/imgWave"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="0.0">

        <!-- EMAIL -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/email_address"
            android:textSize="12sp"
            android:textColor="#5A5A5A" />

        <EditText
            android:id="@+id/edtEmail"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="@string/email_hint"
            android:background="@drawable/edit_bg_luxury"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="16dp"
            android:inputType="textEmailAddress" />

        <!-- PASSWORD -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/password"
            android:textSize="12sp"
            android:textColor="#5A5A5A" />

        <EditText
            android:id="@+id/edtPassword"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="@string/password_hint"
            android:background="@drawable/edit_bg_luxury"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="12dp"
            android:inputType="textPassword" />

        <!-- REMEMBER + FORGOT -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <CheckBox
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/remember_me"
                android:textSize="12sp"
                android:textColor="#5A5A5A"
                android:buttonTint="#8B5E2E" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/forgot_password"
                android:textSize="12sp"
                android:textColor="#1C1C1C" />
        </LinearLayout>

        <!-- LOGIN BUTTON -->
        <Button
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="@string/login"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:background="@drawable/btn_luxury" />

        <!-- SIGN UP -->
        <TextView
            android:id="@+id/tvSignUp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="@string/sign_up"
            android:textSize="13sp"
            android:textColor="#5A5A5A" />


    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
